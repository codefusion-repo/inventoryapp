rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function employee() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function employeeRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isWarehouse() {
      return employee() && employeeRole() == 'almacen';
    }
    function isSeller() {
      return employee() && employeeRole() == 'vendedor';
    }

    // Invitados autenticados de forma anónima pueden ver el catálogo,
    // pero NO consultar perfiles de empleados ni modificar productos.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /inventory_products/{productId} {
      function validData() {
        return request.resource.data.keys().hasOnly([
          'id', 'nombre', 'descripcion', 'categoria', 'proveedor',
          'cantidad', 'precioClp', 'updatedAtMillis', 'changeId',
          'updatedBy', 'deleted', 'serverUpdatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'nombre', 'descripcion', 'categoria', 'proveedor',
          'cantidad', 'precioClp', 'updatedAtMillis', 'changeId',
          'updatedBy', 'deleted', 'serverUpdatedAt'
        ])
        && request.resource.data.id == productId
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.descripcion is string
        && request.resource.data.categoria is string
        && request.resource.data.proveedor is string
        && request.resource.data.proveedor.size() >= 1
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 0
        && request.resource.data.precioClp is int
        && request.resource.data.precioClp >= 0
        && request.resource.data.updatedAtMillis is int
        && request.resource.data.changeId is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.deleted is bool
        && request.resource.data.serverUpdatedAt == request.time;
      }
      function onlyStockChange() {
        return isSeller()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'cantidad', 'updatedAtMillis', 'changeId', 'updatedBy', 'serverUpdatedAt'
          ])
          && request.resource.data.deleted == resource.data.deleted
          && request.resource.data.id == resource.data.id;
      }

      // Cualquier usuario autenticado, incluso invitado anónimo, puede leer.
      allow get, list: if signedIn();
      allow create: if isWarehouse() && validData();
      allow update: if validData() && (isWarehouse() || onlyStockChange());
      // Baja lógica: almacén cambia 'deleted' mediante update.
      allow delete: if false;
    }
  }
}
