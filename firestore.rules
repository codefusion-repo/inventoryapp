rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function canRead() {
      return hasProfile() && role() in ['vendedor', 'almacen'];
    }
    function canWrite() {
      return hasProfile() && role() == 'almacen';
    }

    // Los perfiles se crean desde Firebase Console por el administrador del proyecto.
    // El cliente no puede asignarse ni modificar su propio rol.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /inventory_products/{productId} {
      function validData() {
        return request.resource.data.keys().hasOnly([
            'id', 'nombre', 'descripcion', 'categoria', 'proveedor',
            'cantidad', 'precioClp', 'updatedAtMillis', 'changeId',
            'updatedBy', 'deleted', 'serverUpdatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'nombre', 'descripcion', 'categoria', 'proveedor',
            'cantidad', 'precioClp', 'updatedAtMillis', 'changeId',
            'updatedBy', 'deleted', 'serverUpdatedAt'
          ])
          && request.resource.data.id == productId
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 2
          && request.resource.data.descripcion is string
          && request.resource.data.categoria is string
          && request.resource.data.proveedor is string
          && request.resource.data.proveedor.size() >= 1
          && request.resource.data.cantidad is int
          && request.resource.data.cantidad >= 0
          && request.resource.data.precioClp is int
          && request.resource.data.precioClp >= 0
          && request.resource.data.updatedAtMillis is int
          && request.resource.data.changeId is string
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.deleted is bool
          && request.resource.data.serverUpdatedAt == request.time;
      }

      allow get, list: if canRead();
      allow create, update: if canWrite() && validData();
      // Baja lógica: la eliminación definitiva impediría replicar el cambio.
      allow delete: if false;
    }
  }
}
